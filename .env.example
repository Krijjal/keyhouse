# Copy to .env and replace every "change-me" value. .env is gitignored.
# Generate strong values with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

NODE_ENV=development

# --- Postgres ---
# Bootstrap superuser: used only by the container's first-start init script.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# keyhouse_owner owns the schema and runs migrations. keyhouse_app is the running idp.
KEYHOUSE_OWNER_PASSWORD=change-me-owner
KEYHOUSE_APP_PASSWORD=change-me-app
# Runtime connection (least privilege).
DATABASE_URL=postgresql://keyhouse_app:change-me-app@127.0.0.1:5432/keyhouse
# Migrations only (prisma migrate).
MIGRATION_DATABASE_URL=postgresql://keyhouse_owner:change-me-owner@127.0.0.1:5432/keyhouse
# Separate database for integration tests, same two roles.
TEST_DATABASE_URL=postgresql://keyhouse_app:change-me-app@127.0.0.1:5432/keyhouse_test
TEST_MIGRATION_DATABASE_URL=postgresql://keyhouse_owner:change-me-owner@127.0.0.1:5432/keyhouse_test

# --- Redis (rate limiting) ---
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379/0
# Tests use a separate logical DB so they can flush it.
TEST_REDIS_URL=redis://:change-me@127.0.0.1:6379/1

# --- Mail (Mailpit in dev; UI at http://localhost:8025) ---
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="KeyHouse <no-reply@keyhouse.local>"

# --- idp (Express API) ---
IDP_PORT=4000
# Public base URL of the API, used to build links.
IDP_PUBLIC_URL=http://localhost:4000

# --- web (Next.js UI) ---
# The only origin allowed by CORS and the Origin check.
WEB_ORIGIN=http://localhost:3000
