{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Next.js bundles the code itself, so TypeScript only type-checks.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "vitest.config.ts",
    "src",
    "test",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
